# Senha única que vocês dois usam para entrar no site.
APP_PASSWORD=casa

# Preenchidas sozinhas pela Vercel ao conectar o Upstash Redis e o Blob na aba Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Só se o Blob store foi criado como público (o padrão do app é privado).
# BLOB_ACCESS=public
